# Senha para entrar no painel administrativo (/admin)
ADMIN_PASSWORD=troque-esta-senha

# Segredo usado para assinar o cookie de sessão do painel.
# Gere um valor aleatório com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Banco de dados. Se ficar vazio, usa um arquivo SQLite local em ./data/voz-jovem.db
# Para publicar (ex.: Turso): libsql://seu-banco.turso.io
DATABASE_URL=file:./data/voz-jovem.db
DATABASE_AUTH_TOKEN=
